# Служебные файлы операционной системы не являются данными проекта
.DS_Store

# Локальные переменные окружения
.env
.env.*
*.env
*.env.*

# Безопасные примеры должны храниться в Git
!.env.example
!*.env.example

# Закрытые ключи и сертификаты
*.key
*.pem
*.p12
*.pfx

# Явные каталоги секретов
secrets/
credentials/

# Типовые файлы учётных данных
credentials.json
service-account*.json

# Другие исключения добавляются только после решения пользователя во время START.
# Значимые данные проекта сохраняются; кэш и воспроизводимые зависимости исключаются
# только по подтверждённой политике конкретного проекта.
