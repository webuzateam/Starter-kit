# Starter Kit: base exclusions. Secrets are always excluded.
# Other rules are added only by the user's decision during START.

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local environment variables
.env
.env.*
*.env
*.env.*

# Safe examples must stay in Git
!.env.example
!*.env.example

# Private keys, certificates and keystores
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!*.pub

# Credential folders and typical credential files
secrets/
credentials/
credentials.json
service-account*.json

# Local AI client settings that may contain personal data
.claude/settings.local.json

# Caches, builds and dependencies (node_modules/, .venv/, dist/, etc.)
# are added here only per the confirmed project policy.
