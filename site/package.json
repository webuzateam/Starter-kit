{
  "name": "ai-project-starter-kit-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler pages dev out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "deploy": "npm run check && wrangler pages deploy out --project-name webuza-ai-starter-kit --branch main"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true
  }
}
