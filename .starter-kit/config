# Starter Kit settings for .starter-kit/preflight.sh.
# Filled during APPLY and Git setup (prompts/03-setup-git-github.md).
# Format: key=value, no spaces or quotes. No secrets.
# An empty value means "not agreed" — push will be stopped.

# private or public
visibility=

# Agreed origin URL, e.g. https://github.com/owner/project.git
remote=

# Main branch
branch=main

# Large file threshold in MiB
large_file_mib=50
